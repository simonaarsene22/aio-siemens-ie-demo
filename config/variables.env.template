# ============================================================
# AIO + Siemens IE Demo — configuration
# 1. Copy:   cp config/variables.env.template config/variables.env
# 2. Fill in every <CHANGE_ME> value
# 3. Source before running any script:
#      source config/variables.env
# ============================================================

# ── Azure ────────────────────────────────────────────────────
export SUBSCRIPTION_ID="<CHANGE_ME>"          # az account show --query id -o tsv
export RESOURCE_GROUP="rg-aio-siemens-demo"   # choose any name
export LOCATION="eastus"                       # eastus | westeurope | ...

# ── Arc + AIO ────────────────────────────────────────────────
export CLUSTER_NAME="k3s-aio-demo"            # logical name shown in Azure Portal
export AIO_INSTANCE_NAME="aio-demo-instance"

# ── Schema Registry + Storage ────────────────────────────────
export STORAGE_ACCOUNT="<CHANGE_ME>"          # 3-24 lowercase alphanumeric, globally unique
export SCHEMA_REGISTRY="sr-aio-demo"
export SCHEMA_REGISTRY_NAMESPACE="srns-aio-demo"

# ── Azure Device Registry ────────────────────────────────────
export ADR_NAMESPACE="ns-aio-demo"

# ── Event Hub ────────────────────────────────────────────────
export EH_NAMESPACE="<CHANGE_ME>"             # globally unique, e.g. eh-aio-demo-contoso
export EH_CNC_NAME="cnc-telemetry"            # Event Hub for Siemens IE CNC data
