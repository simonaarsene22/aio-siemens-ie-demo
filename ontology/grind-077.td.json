{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "siemens": "urn:siemens:ie:profile:machine-operational-data:v1:"
    }
  ],
  "id": "urn:siemens:ie:asset:GRIND-077",
  "title": "Legacy S7-300 Grinding Cell GRIND-077",
  "description": "WoT capability model for Legacy S7-300 Grinding Cell GRIND-077, generated from its AAS submodel. Conforms to urn:siemens:ie:profile:machine-operational-data:v1.",
  "securityDefinitions": {
    "nosec_sc": {
      "scheme": "nosec"
    }
  },
  "security": [
    "nosec_sc"
  ],
  "properties": {
    "MotorSpeed_RPM": {
      "@type": "siemens:MotorSpeed_RPM",
      "type": "number",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['DB10.DBD4']",
          "siemens:transform": "identity"
        }
      ],
      "unit": "RPM",
      "description": "Grinding wheel motor rotational speed."
    },
    "SpindleLoad_Pct": {
      "@type": "siemens:SpindleLoad_Pct",
      "type": "number",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.MW102",
          "siemens:transform": "divide_10"
        }
      ],
      "unit": "%",
      "description": "Wheel motor load as percent of rated torque."
    },
    "FeedRate_mm_min": {
      "@type": "siemens:FeedRate_mm_min",
      "type": "number",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['DB10.DBD8']",
          "siemens:transform": "identity"
        }
      ],
      "unit": "mm/min",
      "description": "Table feed rate."
    },
    "ToolTemperature_C": {
      "@type": "siemens:ToolTemperature_C",
      "type": "number",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['DB10.DBD12']",
          "siemens:transform": "fahrenheit_to_celsius"
        }
      ],
      "unit": "degC",
      "description": "Grinding wheel temperature."
    },
    "PartCount": {
      "@type": "siemens:PartCount",
      "type": "integer",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['DB20.DBW0']",
          "siemens:transform": "identity"
        }
      ],
      "unit": "count",
      "description": "Cumulative parts produced since asset startup."
    },
    "FaultCode": {
      "@type": "siemens:FaultCode",
      "type": "integer",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['DB10.DBW20']",
          "siemens:transform": "identity"
        }
      ],
      "description": "Active fault/alarm code, 0 = no fault."
    },
    "RunningStatus": {
      "@type": "siemens:RunningStatus",
      "type": "boolean",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['M20.1']",
          "siemens:transform": "int_to_bool"
        }
      ],
      "description": "True while the wheel motor is running."
    },
    "OEE_Pct": {
      "@type": "siemens:OEE_Pct",
      "type": "number",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://<AIO_BROKER_HOST>:1883/s7/grind077",
          "op": "observeproperty",
          "contentType": "application/json",
          "siemens:jsonPath": "$.['DB30.DBD0']",
          "siemens:transform": "fraction_to_percent"
        }
      ],
      "unit": "%",
      "description": "Overall Equipment Effectiveness."
    }
  }
}
